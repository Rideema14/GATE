# PostgreSQL connection string. Works locally and in production with the same
# provider, so there is no dev/prod database mismatch.
# Get a free instance from Neon (https://neon.tech) or Supabase (https://supabase.com).
# Example (Neon): postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Without this, playlist import is disabled but manual resource
# tracking still works. Create a key in Google Cloud Console with the
# YouTube Data API v3 enabled.
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"

# Required for the per-video "Generate notes" feature (formula extraction +
# study notes). Free key at https://console.groq.com/keys. Keep it server-side.
GROQ_API_KEY="your-groq-api-key"
# Optional: override the model used for notes (default: openai/gpt-oss-120b).
# GROQ_MODEL="openai/gpt-oss-120b"
